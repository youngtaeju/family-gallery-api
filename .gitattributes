# 저장소 내 기본 정규화. 텍스트 파일은 LF로 저장.
* text=auto

# 컨테이너에서 실행. LF 고정 필요.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 전용 스크립트
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
