{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/app/family-gallery.db"
  },
  "Jwt": {
    "Issuer": "family-gallery-api",
    "Audience": "family-gallery-app",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 60
  },
  "Gallery": {
    "RootPath": "/data/gallery"
  }
}
